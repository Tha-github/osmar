---
/**
 * Acordeão nativo com <details>/<summary> — sem JS. O ícone é um traço
 * horizontal fixo mais um traço vertical que gira 90° com o atributo
 * [open] (via variant group-open do Tailwind), virando um "menos" em vez
 * da seta padrão de disclosure.
 */
import { faq } from '../data/faq';

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.pergunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.resposta,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

<section id="faq" class="section-y bg-papel text-grafite">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<div class="grid grid-cols-1 md:grid-cols-12">
			<div class="text-center md:col-span-9 md:col-start-3 md:text-left">
				<h2 class="font-display text-display-lg">Perguntas frequentes</h2>

				<div class="mt-12 flex flex-col text-left md:mt-16">
					{
						faq.map((item) => (
							<details class="faq-item group border-t border-grafite/15 py-6 last:border-b">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-6">
									<span class="font-display text-display-md">{item.pergunta}</span>
									<span class="relative h-4 w-4 shrink-0" aria-hidden="true">
										<span class="absolute inset-y-1/2 inset-x-0 h-px -translate-y-1/2 bg-coroa" />
										<span class="absolute inset-x-1/2 inset-y-0 w-px -translate-x-1/2 bg-coroa transition-transform duration-300 group-open:rotate-90" />
									</span>
								</summary>
								<p class="mt-4 max-w-prose text-body text-grafite/70">{item.resposta}</p>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.faq-item summary::-webkit-details-marker {
		display: none;
	}
</style>
