---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import LinkSublinhado from './LinkSublinhado.astro';
import { paraQuem } from '../data/paraQuem';

import fotoResidencial from '../assets/para-quem/residencial.jpg';
import fotoEmpresarial from '../assets/para-quem/empresas.jpg';
import fotoRural from '../assets/para-quem/arearural.jpg';
import fotoCondominios from '../assets/para-quem/condominio.jpg';

const fotos = [fotoResidencial, fotoEmpresarial, fotoRural, fotoCondominios];
---

<section id="para-quem" class="section-y bg-papel text-grafite">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<SectionHeading size="lg" class="text-center md:text-left">Para quem</SectionHeading>

		<div class="mt-16 flex flex-col gap-20 md:mt-20 md:gap-28">
			{
				paraQuem.map((item, index) => (
					<div
						class:list={[
							'flex flex-col gap-8 md:items-center md:gap-16',
							index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse',
						]}
					>
						<div class="md:w-1/2">
							{/*
								As fotos de origem não vêm em 4:3 (residencial é quadrada, as
								outras três são widescreen 16:9) — object-cover preenche a
								caixa sem distorcer, cortando o excesso centralizado.
							*/}
							<div class="relative aspect-[4/3] w-full overflow-hidden bg-grafite/5">
								<Image
									src={fotos[index]}
									alt={item.alt}
									width={800}
									height={600}
									loading="lazy"
									format="avif"
									class="h-full w-full object-cover"
								/>
							</div>
						</div>

						<div class="text-center md:w-1/2 md:text-left">
							<span class="font-mono text-mono uppercase tracking-widest text-grafite/60">{item.rotulo}</span>
							<h3 class="font-display mt-3 text-display-md">{item.titulo}</h3>
							<p class="mx-auto mt-4 max-w-md text-body text-grafite/70 md:mx-0">{item.paragrafos[0]}</p>
							<p class="mx-auto mt-3 max-w-md text-body text-grafite/70 md:mx-0">{item.paragrafos[1]}</p>
							<LinkSublinhado href={item.link.href} class="mt-6 text-grafite">
								{item.link.label}
							</LinkSublinhado>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
