---
/**
 * Timeline vertical de 5 etapas reais (numeração permitida aqui, ao
 * contrário do resto do site, porque existe sequência de fato). Sem linha
 * conectando os marcadores — só os números e o espaçamento vertical
 * carregam a sequência.
 *
 * O número é --coroa sobre --grafite (não sobre --papel): âmbar direto no
 * fundo claro do site dá só ~2:1 de contraste, abaixo do mínimo AA de 4.5:1
 * (achado real ao rodar Lighthouse).
 */
import { comoFunciona } from '../data/comoFunciona';
---

<section id="como-funciona" class="section-y bg-papel text-grafite">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<h2 class="font-display text-display-lg">Como funciona</h2>

		<ol class="relative mt-16 flex flex-col gap-16 md:mt-20">
			{
				comoFunciona.map((etapa, index) => (
					<li class="relative flex gap-6">
						<div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-grafite">
							<span class="font-mono text-mono text-coroa">{String(index + 1).padStart(2, '0')}</span>
						</div>
						<div class="pt-1">
							<h3 class="font-display text-display-md">{etapa.titulo}</h3>
							<p class="mt-2 max-w-md text-body text-grafite/70">{etapa.texto}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
