---
/**
 * Timeline vertical de 5 etapas reais (numeração permitida aqui, ao
 * contrário do resto do site, porque existe sequência de fato). Sem linha
 * conectando os marcadores — só os números e o espaçamento vertical
 * carregam a sequência.
 *
 * O número é --coroa sobre --grafite (não sobre --papel): âmbar direto no
 * fundo claro do site dá só ~2:1 de contraste, abaixo do mínimo AA de 4.5:1
 * (achado real ao rodar Lighthouse).
 *
 * Foto reaproveitada de src/assets/para-quem/ (a seção "Como funciona" não
 * é ligada a um segmento específico, então usa a mesma imagem residencial
 * já tratada/otimizada em vez de pedir um novo arquivo).
 */
import { Image } from 'astro:assets';
import { comoFunciona } from '../data/comoFunciona';
import { linkWhatsapp, mensagemSecao } from '../lib/whatsapp';
import fotoInstalacao from '../assets/para-quem/residencial.jpg';

const whatsappHref = linkWhatsapp(mensagemSecao('Como funciona'));
---

<section id="como-funciona" class="section-y bg-papel text-grafite">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<div class="grid grid-cols-1 gap-16 md:grid-cols-12 md:gap-8">
			<div class="md:col-span-7">
				<h2 class="font-display text-display-lg">Como funciona</h2>

				<ol class="relative mt-16 flex flex-col gap-16 md:mt-20">
					{
						comoFunciona.etapas.map((etapa, index) => (
							<li class="relative flex gap-6">
								<div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-grafite">
									<span class="font-mono text-mono text-coroa">{String(index + 1).padStart(2, '0')}</span>
								</div>
								<div class="pt-1">
									<h3 class="font-display text-display-md">{etapa.titulo}</h3>
									<p class="mt-2 max-w-md text-body text-grafite/70">{etapa.texto}</p>
								</div>
							</li>
						))
					}
				</ol>

				<div class="mt-16 md:mt-20">
					<a
						href={whatsappHref}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block rounded-sm bg-coroa px-6 py-3 text-body-sm font-medium text-grafite transition hover:brightness-95"
					>
						{comoFunciona.cta.label}
					</a>
				</div>
			</div>

			<div class="md:col-span-5">
				<div class="relative aspect-4/3 w-full overflow-hidden bg-grafite/5 md:aspect-auto md:h-full md:min-h-[420px]">
					<Image
						src={fotoInstalacao}
						alt="Sistema fotovoltaico instalado e em operação no telhado de uma residência"
						width={800}
						height={800}
						loading="lazy"
						format="avif"
						class="h-full w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</div>
</section>
