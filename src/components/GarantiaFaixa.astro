---
import Eyebrow from './Eyebrow.astro';
import ArcDivider from './ArcDivider.astro';
import { garantia } from '../data/garantia';
---

<section id="garantia" class="section-y relative overflow-hidden bg-papel text-grafite">
	<ArcDivider class="pointer-events-none absolute inset-x-0 top-1/2 z-0 -translate-y-1/2" opacity={0.4} />

	<div class="relative z-10 mx-auto max-w-7xl px-6 md:px-10">
		<div class="grid grid-cols-1 md:grid-cols-12">
			<div class="md:col-span-9 md:col-start-3">
				<Eyebrow>{garantia.eyebrow}</Eyebrow>
				<h2 class="font-display mt-6 text-display-xl">{garantia.frase}</h2>
				<p class="mt-6 text-body text-grafite/70">{garantia.nota}</p>
			</div>
		</div>
	</div>
</section>
