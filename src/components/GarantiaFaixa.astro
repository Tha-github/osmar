---
import Eyebrow from './Eyebrow.astro';
import { garantia } from '../data/garantia';
import { linkWhatsapp, mensagemSecao } from '../lib/whatsapp';

const whatsappHref = linkWhatsapp(mensagemSecao('Garantia'));
---

<section id="garantia" class="section-y bg-papel text-grafite">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<div class="grid grid-cols-1 md:grid-cols-12">
			<div class="text-center md:col-span-9 md:col-start-3 md:text-left">
				<Eyebrow>{garantia.eyebrow}</Eyebrow>
				<h2 class="font-display mt-6 text-display-xl">{garantia.frase}</h2>
				<p class="mt-6 text-body text-grafite/70">{garantia.nota}</p>
				<a
					href={whatsappHref}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-8 inline-block rounded-sm bg-coroa px-6 py-3 text-body-sm font-medium text-grafite transition hover:brightness-95"
				>
					{garantia.cta.label}
				</a>
			</div>
		</div>
	</div>
</section>
