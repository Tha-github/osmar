---
/**
 * Faixa de instituições parceiras — sinal de credibilidade discreto, não
 * conteúdo. Fica dentro do MESMO <section> de FormasPagamento (ver uso em
 * FormasPagamento.astro), sem ArcDivider entre os dois: são o mesmo
 * assunto ("como eu pago isso" → "com quem eu posso financiar isso").
 *
 * Os logos são PNG (arquivos reais dos parceiros), não SVG — por isso a
 * recoloração para --grafite usa `mask-image` em vez de `currentColor`:
 * o PNG vira só uma máscara de alpha, e quem pinta a cor é
 * `background-color`. Um <img src="logo.png"> comum não permite recolorir
 * por fora; mask-image sim, porque não lê os pixels de cor, só a
 * transparência.
 */
import { parceiros, parceirosTitulo } from '../data/parceiros';

const arquivos = import.meta.glob('../assets/parceiros/*.png', {
  query: '?url',
  import: 'default',
  eager: true,
}) as Record<string, string>;

function encontrarImagem(nomeArquivo: string): string {
  const chave = Object.keys(arquivos).find((caminho) => caminho.endsWith(`/${nomeArquivo}`));
  if (!chave) {
    throw new Error(`Imagem não encontrada para "${nomeArquivo}" em src/assets/parceiros/`);
  }
  return arquivos[chave];
}

// Os três logos ficam lado a lado em uma linha única em qualquer largura de
// tela (mesma ordem e proporção relativa do desktop) — no mobile, todos
// encolhem juntos por este fator para caber sem quebrar linha nem estourar
// os 360px mínimos exigidos em CLAUDE.md.
const FATOR_MOBILE = 0.62;
---

<aside aria-label="Instituições financeiras parceiras" class="mt-28 md:mt-32">
	<p class="text-center font-mono text-mono uppercase tracking-widest text-grafite/60">
		{parceirosTitulo}
	</p>

	<div class="mx-auto mt-6 flex w-fit flex-nowrap items-center justify-center gap-x-6 min-[480px]:gap-x-14">
		{
			parceiros.map((parceiro) => {
				const urlImagem = encontrarImagem(parceiro.arquivo);
				const alturaDesktop = parceiro.alturaOptica;
				const larguraDesktop = Math.round(parceiro.alturaOptica * parceiro.proporcao);
				const alturaMobile = Math.round(alturaDesktop * FATOR_MOBILE);
				const larguraMobile = Math.round(larguraDesktop * FATOR_MOBILE);
				const conteudo = (
					<span
						role="img"
						aria-label={parceiro.alt}
						class="parceiro-logo inline-block shrink-0 bg-grafite opacity-55 transition-opacity duration-200 hover:opacity-100"
						style={`--altura-mobile: ${alturaMobile}px; --largura-mobile: ${larguraMobile}px; --altura-desktop: ${alturaDesktop}px; --largura-desktop: ${larguraDesktop}px; --logo-url: url(${urlImagem});`}
					/>
				);

				return parceiro.link ? (
					<a href={parceiro.link} target="_blank" rel="noopener noreferrer" aria-label={parceiro.alt}>
						{conteudo}
					</a>
				) : (
					conteudo
				);
			})
		}
	</div>
</aside>

<style>
	.parceiro-logo {
		-webkit-mask-image: var(--logo-url);
		mask-image: var(--logo-url);
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		height: var(--altura-mobile);
		width: var(--largura-mobile);
	}

	@media (min-width: 480px) {
		.parceiro-logo {
			height: var(--altura-desktop);
			width: var(--largura-desktop);
		}
	}
</style>
