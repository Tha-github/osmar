---
import Eyebrow from './Eyebrow.astro';
import GenerationCurve from './GenerationCurve.astro';
import { hero } from '../data/hero';
import { linkWhatsapp, mensagemSecao } from '../lib/whatsapp';

const whatsappHref = linkWhatsapp(mensagemSecao('Início'));
---

<section class="relative overflow-hidden bg-umbra text-dia">
	<div
		class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 pb-16 pt-32 md:grid-cols-12 md:gap-8 md:px-10 md:pb-24 md:pt-40"
	>
		<div class="md:col-span-7">
			<Eyebrow class="text-luz">{hero.eyebrow}</Eyebrow>

			<h1 class="font-display mt-6 text-display-2xl">{hero.titulo}</h1>

			<p class="mt-6 max-w-prose text-body-lg text-dia/80">{hero.paragrafo}</p>

			<p class="mt-4 max-w-prose text-body text-dia/70">
				{hero.linhaMonitoramento} {hero.linhaGarantia}
			</p>
			<p class="mt-2 max-w-prose font-mono text-mono uppercase tracking-widest text-dia/60">{hero.notaGarantia}</p>

			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a
					href={hero.ctaPrimario.href}
					class="rounded-sm bg-coroa px-6 py-3 text-body-sm font-medium text-grafite transition hover:brightness-95"
				>
					{hero.ctaPrimario.label}
				</a>
				<a
					href={whatsappHref}
					target="_blank"
					rel="noopener noreferrer"
					class="rounded-sm border border-dia/30 px-6 py-3 text-body-sm font-medium text-dia transition hover:border-coroa hover:text-coroa"
				>
					{hero.ctaSecundario.label}
				</a>
			</div>

			<ul class="mt-12 flex flex-wrap items-center gap-4">
				<li class="font-mono text-mono uppercase tracking-widest text-dia/70">{hero.provas[0]}</li>
				<li aria-hidden="true" class="text-dia/40">·</li>
				<li class="font-mono text-mono uppercase tracking-widest text-dia/70">{hero.provas[1]}</li>
				<li aria-hidden="true" class="text-dia/40">·</li>
				<li class="font-mono text-mono uppercase tracking-widest text-dia/70">{hero.provas[2]}</li>
			</ul>
		</div>

		<div class="md:col-span-5">
			<GenerationCurve />
		</div>
	</div>
</section>
