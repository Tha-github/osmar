---
import Eyebrow from './Eyebrow.astro';
import { empresa } from '../data/empresa';
import { navPrincipal } from '../data/navegacao';
import { avisoLgpd, irradianciaCuiaba } from '../data/rodape';

function formatTelefone(numero: string) {
  const digits = numero.replace(/\D/g, '');
  return `(${digits.slice(0, 2)}) ${digits.slice(2, 7)}-${digits.slice(7)}`;
}
---

<footer class="section-y bg-umbra text-dia">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<div class="grid grid-cols-1 gap-12 md:grid-cols-12">
			<div class="md:col-span-5">
				<span class="font-display text-display-md">{empresa.nome}</span>
				<p class="mt-4 max-w-prose text-body-sm text-dia/80">
					Projeto, instalação, monitoramento e manutenção de sistemas fotovoltaicos em {empresa.regiaoAtendida}.
				</p>

				<div class="mt-6 flex gap-4">
					<a
						href="https://instagram.com/ozenergiasolar"
						class="text-luz"
						aria-label="Instagram da OZ Energia Solar"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3">
							<rect x="1.5" y="1.5" width="15" height="15" rx="4"></rect>
							<circle cx="9" cy="9" r="3.6"></circle>
							<circle cx="13.2" cy="4.8" r="0.6" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
					<a
						href="https://facebook.com/ozenergiasolar"
						class="text-luz"
						aria-label="Facebook da OZ Energia Solar"
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3">
							<circle cx="9" cy="9" r="7.5"></circle>
							<path
								d="M10.8 6.3H9.3c-.7 0-1.2.5-1.2 1.2v1.5h2.5M8.1 9v6"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</div>

			<div class="md:col-span-2 md:col-start-7">
				<Eyebrow>Contato</Eyebrow>
				<ul class="mt-4 flex flex-col gap-2 text-body-sm">
					<li>
						<a href={`tel:+55${empresa.telefone}`} class="transition-colors hover:text-coroa">
							{formatTelefone(empresa.telefone)}
						</a>
					</li>
					<li>
						<a href={`mailto:${empresa.email}`} class="transition-colors hover:text-coroa">
							{empresa.email}
						</a>
					</li>
				</ul>
			</div>

			<div class="md:col-span-2 md:col-start-9">
				<Eyebrow>Endereço</Eyebrow>
				<p class="mt-4 text-body-sm text-dia/80">
					{empresa.endereco.logradouro}<br />
					{empresa.endereco.bairro} — {empresa.endereco.cidade}/{empresa.endereco.estado}<br />
					CEP {empresa.endereco.cep}
				</p>
				<p class="mt-4 text-body-sm text-dia/80">{empresa.horarioFuncionamento}</p>
			</div>

			<div class="md:col-span-2 md:col-start-11">
				<Eyebrow>Mapa do site</Eyebrow>
				<nav aria-label="Mapa do site">
					<ul class="mt-4 flex flex-col gap-2 text-body-sm">
						{
							navPrincipal.map((item) => (
								<li>
									<a href={item.href} class="transition-colors hover:text-coroa">
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</div>

		<div class="mt-16 flex flex-col gap-4 text-body-sm text-dia/70 md:flex-row md:items-start md:justify-between">
			<p>{empresa.nome}. Todos os direitos reservados. Site desenvolvido por TopSite</p>
			<p class="max-w-prose">{avisoLgpd}</p>
		</div>

		<p class="mt-8 font-mono text-mono uppercase tracking-widest text-luz">
			{irradianciaCuiaba.valor} — irradiância média em Cuiabá, MT
		</p>
	</div>
</footer>
