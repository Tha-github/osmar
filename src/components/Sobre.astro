---
import Eyebrow from './Eyebrow.astro';
import { sobre } from '../data/sobre';
---

<section id="sobre" class="section-y bg-papel text-grafite">
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<div class="grid grid-cols-1 md:grid-cols-12">
			<div class="text-center md:col-span-9 md:col-start-3 md:text-left">
				<Eyebrow>{sobre.eyebrow}</Eyebrow>
				<h2 class="font-display mt-6 text-display-lg">{sobre.titulo}</h2>

				<div class="mx-auto mt-8 flex max-w-prose flex-col gap-4 text-body text-grafite/70 md:mx-0">
					{sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
				</div>
			</div>
		</div>
	</div>
</section>
