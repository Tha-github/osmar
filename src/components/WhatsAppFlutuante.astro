---
/**
 * Botão flutuante de WhatsApp, deliberadamente discreto: sem balão verde,
 * sem preenchimento de destaque — só um ícone monoline (o mesmo traço fino
 * usado nos ícones do rodapé) sobre um fundo neutro escuro.
 *
 * Diferente dos outros botões de WhatsApp do site (que já sabem de qual
 * seção partem, porque vivem dentro dela), este é fixo na tela inteira —
 * por isso detecta a seção mais visível no momento do clique via
 * IntersectionObserver, para a mensagem sempre citar de onde o cliente veio.
 */
import { empresa } from '../data/empresa';
import { secaoPorId } from '../lib/whatsapp';

const mensagemPadrao = encodeURIComponent(`Olá! Vim da seção ${secaoPorId.inicio} do site e quero saber mais.`);
const hrefPadrao = `https://wa.me/55${empresa.whatsapp}?text=${mensagemPadrao}`;
---

<a
	id="whatsapp-flutuante"
	href={hrefPadrao}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Falar no WhatsApp com a OZ Energia Solar"
	class="fixed bottom-6 right-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-grafite text-dia shadow-sm transition hover:bg-umbra"
>
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<path
			d="M4 21l1.3-4.1A8.5 8.5 0 1 1 8.9 20L4 21Z"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"></path>
		<path
			d="M8.5 9.8c0 3.6 2.9 6.2 6.2 6.2"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"></path>
	</svg>
</a>

<script define:vars={{ whatsappNumero: empresa.whatsapp, secoesPorId: secaoPorId }}>
	const botao = document.getElementById('whatsapp-flutuante');

	const secoes = Object.keys(secoesPorId)
		.map((id) => document.getElementById(id))
		.filter((el) => el !== null);

	function definirSecaoAtual(nomeSecao) {
		const mensagem = `Olá! Vim da seção ${nomeSecao} do site e quero saber mais.`;
		botao.href = `https://wa.me/55${whatsappNumero}?text=${encodeURIComponent(mensagem)}`;
	}

	const observer = new IntersectionObserver(
		(entries) => {
			const maisVisivel = entries
				.filter((entrada) => entrada.isIntersecting)
				.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

			if (maisVisivel) {
				definirSecaoAtual(secoesPorId[maisVisivel.target.id]);
			}
		},
		{ threshold: [0.25, 0.5, 0.75] },
	);

	secoes.forEach((secao) => observer.observe(secao));
</script>
